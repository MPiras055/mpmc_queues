# GENERATED AT CONFIGURE TIME -- edit cmake/clangd.in, not this file.
#
# Why this exists:
#   compile_commands.json only ever contains translation units, never headers. When you
#   open a header, clangd has to *infer* a command from the "nearest" indexed file. In
#   this layout the project's headers live under include/ while every TU lives under
#   src/, so the nearest match clangd finds is a googletest source file. That command
#   carries googletest's include directories and not this project's, so every
#   `#include <core/...>` in a header resolves to nothing and the editor fills with
#   "file not found" even though the build is perfectly fine.
#
#   The Add: block below supplies the flags that inference cannot.

CompileFlags:
  CompilationDatabase: @CLANGD_DB_DIR@
  Add:
    - -std=c++20
    - -I@PROJECT_SOURCE_DIR@/include
    - -I@CLANGD_GTEST_INCLUDE@
    # Matches the build: the 16-byte CAS VyukovDCAS needs on x86_64.
    - -mcx16
  # Headers are parsed standalone, so let clangd treat them as self-contained TUs.
  CompilationDatabaseChanges: {}

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
